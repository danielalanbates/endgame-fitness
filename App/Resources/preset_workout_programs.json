            ]
          },
          "day_2": {
            "name": "Bench Press Day (Week 1: 5/5/5+)",
            "focus": "Upper Body - Bench",
            "exercises": [
              {"name": "Bench Press", "sets": "3", "reps": "5/5/5+", "weight": "65%/75%/85% of 1RM", "rest": "3-5 min", "notes": "Main lift - AMRAP on last set"},
              {"name": "Overhead Press", "sets": "5", "reps": "10", "weight": "Moderate", "rest": "90 sec"},
              {"name": "Dumbbell Rows", "sets": "5", "reps": "10", "weight": "Moderate", "rest": "90 sec"},
              {"name": "Tricep Extensions", "sets": "5", "reps": "15", "weight": "Light", "rest": "60 sec"},
              {"name": "Face Pulls", "sets": "5", "reps": "20", "weight": "Light", "rest": "60 sec"}
            ]
          },
          "day_3": {
            "name": "Deadlift Day (Week 1: 5/5/5+)",
            "focus": "Lower Body - Deadlift",
            "exercises": [
              {"name": "Deadlift", "sets": "3", "reps": "5/5/5+", "weight": "65%/75%/85% of 1RM", "rest": "3-5 min", "notes": "Main lift - AMRAP on last set"},
              {"name": "Front Squat", "sets": "5", "reps": "8", "weight": "Moderate", "rest": "90 sec"},
              {"name": "Leg Extensions", "sets": "5", "reps": "15", "weight": "Moderate", "rest": "60 sec"},
              {"name": "Hanging Leg Raises", "sets": "5", "reps": "12", "weight": "Bodyweight", "rest": "60 sec"},
              {"name": "Planks", "sets": "3", "reps": "60 sec hold", "weight": "Bodyweight", "rest": "60 sec"}
            ]
          },
          "day_4": {
            "name": "Overhead Press Day (Week 1: 5/5/5+)",
            "focus": "Upper Body - Press",
            "exercises": [
              {"name": "Overhead Press", "sets": "3", "reps": "5/5/5+", "weight": "65%/75%/85% of 1RM", "rest": "3-5 min", "notes": "Main lift - AMRAP on last set"},
              {"name": "Incline Bench Press", "sets": "5", "reps": "10", "weight": "Moderate", "rest": "90 sec"},
              {"name": "Pull-ups", "sets": "5", "reps": "8-10", "weight": "Bodyweight", "rest": "90 sec"},
              {"name": "Lateral Raises", "sets": "5", "reps": "15", "weight": "Light", "rest": "60 sec"},
              {"name": "Bicep Curls", "sets": "5", "reps": "12", "weight": "Moderate", "rest": "60 sec"}
            ]
          }
        }
