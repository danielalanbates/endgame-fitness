    {
      "id": "starting-strength",
      "name": "Starting Strength",
      "description": "Mark Rippetoe's beginner strength program focusing on compound movements",
      "weeks": 12,
      "daysPerWeek": 3,
      "difficulty": "Beginner",
      "goal": "Strength",
      "schedule": {
        "week_1": {
          "day_1": {
            "name": "Workout A",
            "focus": "Full Body - Squat Focus",
            "exercises": [
              {"name": "Squat", "sets": "3", "reps": "5", "weight": "Add 5-10 lbs each session", "rest": "3-5 min", "notes": "Main compound lift"},
              {"name": "Bench Press", "sets": "3", "reps": "5", "weight": "Add 5 lbs each session", "rest": "3-5 min", "notes": "Upper body push"},
              {"name": "Deadlift", "sets": "1", "reps": "5", "weight": "Add 10 lbs each session", "rest": "5 min", "notes": "One heavy set only"}
            ]
          },
          "day_2": {
            "name": "Workout B",
            "focus": "Full Body - Press Focus",
            "exercises": [
              {"name": "Squat", "sets": "3", "reps": "5", "weight": "Add 5-10 lbs each session", "rest": "3-5 min", "notes": "Main compound lift"},
              {"name": "Overhead Press", "sets": "3", "reps": "5", "weight": "Add 2.5-5 lbs each session", "rest": "3-5 min", "notes": "Upper body push"},
              {"name": "Power Clean", "sets": "5", "reps": "3", "weight": "Add 5 lbs each session", "rest": "3 min", "notes": "Explosive power"}
            ]
          },
          "day_3": {
            "name": "Workout A (Repeated)",
            "focus": "Full Body - Squat Focus",
            "exercises": [
              {"name": "Squat", "sets": "3", "reps": "5", "weight": "Add 5-10 lbs from last A workout", "rest": "3-5 min"},
              {"name": "Bench Press", "sets": "3", "reps": "5", "weight": "Add 5 lbs from last A workout", "rest": "3-5 min"},
              {"name": "Deadlift", "sets": "1", "reps": "5", "weight": "Add 10 lbs from last A workout", "rest": "5 min"}
            ]
          }
        }
      },
      "notes": "Alternate A/B workouts (A-B-A, B-A-B). Linear progression - add weight every session. Deload when you fail 3 times on same weight."
    },
