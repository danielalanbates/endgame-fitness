              {"name": "Romanian Deadlift", "sets": "5", "reps": "10", "weight": "Moderate", "rest": "90 sec"},
              {"name": "Leg Press", "sets": "5", "reps": "15", "weight": "Moderate", "rest": "90 sec"},
              {"name": "Leg Curls", "sets": "5", "reps": "10", "weight": "Moderate", "rest": "60 sec"},
