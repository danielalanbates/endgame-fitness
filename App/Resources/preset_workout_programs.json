      "name": "5/3/1 Wendler",
      "description": "Jim Wendler's proven strength program with progressive overload over 4-week cycles",
      "weeks": 12,
      "daysPerWeek": 4,
      "difficulty": "Intermediate",
      "goal": "Strength",
      "schedule": {
